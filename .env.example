# ==============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma ORM)
# ==============================================================================
# Pooled database connection string (runtime Next.js serverless queries)
# When using Supabase / Neon, use the Transaction Pooler (port 6543) with ?pgbouncer=true
# connection_limit & pool_timeout optimize high-concurrency exam bursts (see DATABASE_OPTIMIZATION.md)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=30&pool_timeout=20"

# Direct database connection string (used by Prisma CLI for schema migrations & db push)
# Connects directly to PostgreSQL without PgBouncer (standard port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# 2. SECURITY & SESSION AUTHENTICATION
# ==============================================================================
# Random 32+ character secret key used for signing session JWT tokens (BcryptJS / Jose)
# Generate a secure key in your terminal with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="your_minimum_32_character_random_hex_string_here"

# ==============================================================================
# 3. APPLICATION DOMAIN & BASE URLS
# ==============================================================================
# Public URL of your deployed application on Vercel (without trailing slash)
# Used for candidate login link generation in automated credential emails
NEXT_PUBLIC_APP_URL="https://examination-system-saa-s-opew.vercel.app"

# Base URL used for Azure Marketplace redirect resolution and webhook callbacks
APP_BASE_URL="https://examination-system-saa-s-opew.vercel.app"

# ==============================================================================
# 4. SMTP / EMAIL CONFIGURATION (Nodemailer Batch Dispatch)
# ==============================================================================
# Host of your SMTP provider (e.g., smtp.gmail.com, smtp.sendgrid.net, smtp.resend.com)
SMTP_HOST="smtp.gmail.com"

# SMTP port: 587 (TLS/STARTTLS) or 465 (SSL)
SMTP_PORT=587

# SMTP authentication username (email address or API key username)
SMTP_USER="notifications@yourdomain.com"

# SMTP authentication password (e.g. Gmail 16-character App Password, or SendGrid API Key)
SMTP_PASS="your-smtp-app-password-or-api-key"

# Enable SSL/TLS: set to true if using port 465, or false if using port 587
SMTP_SECURE=false

# Sender email and display name shown in candidates' inbox
SMTP_FROM='"Global Minds Examination Portal" <noreply@yourdomain.com>'

# ==============================================================================
# 5. MICROSOFT AZURE MARKETPLACE SAAS FULFILLMENT
# ==============================================================================
# The Azure Active Directory (Entra ID) Tenant ID where your App Registration was created
MARKETPLACE_TENANT_ID="your-azure-tenant-id-guid"

# The Application (Client) ID of your registered app in Azure Portal
# Also used as the expected audience (aud) to validate incoming Microsoft Marketplace webhooks
MARKETPLACE_CLIENT_ID="your-azure-app-client-id-guid"

# The Application Client Secret value generated under 'Certificates & secrets' in Azure Portal
MARKETPLACE_CLIENT_SECRET="your-azure-app-client-secret"

# Standard Azure Marketplace SaaS Resource ID (Keep this default)
# Default: 20e940b3-4c77-4b0b-9a53-9e16a1b010a7
MARKETPLACE_RESOURCE_ID="20e940b3-4c77-4b0b-9a53-9e16a1b010a7"

# Partner Center Publisher ID under Commercial Marketplace
MARKETPLACE_PUBLISHER_ID="your-partner-center-publisher-id"

# Partner Center Offer ID configured under Commercial Marketplace
MARKETPLACE_OFFER_ID="your-saas-offer-id"

# ==============================================================================
# 6. AWS MARKETPLACE SAAS FULFILLMENT (EventBridge & Metering)
# ==============================================================================
# AWS Region where AWS Marketplace services reside (Standard: us-east-1)
AWS_MARKETPLACE_REGION="us-east-1"

# IAM User Access Key ID with permissions for Marketplace Metering & Entitlement
# Required IAM Policies:
# - aws-marketplace:ResolveCustomer
# - aws-marketplace:GetEntitlements
# - aws-marketplace:BatchMeterUsage (if usage metering is used)
# - sqs:ReceiveMessage, sqs:DeleteMessage (if using SQS EventBridge buffer)
AWS_MARKETPLACE_ACCESS_KEY_ID="your-aws-access-key-id"

# IAM User Secret Access Key
AWS_MARKETPLACE_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Product Code assigned to your SaaS product in the AWS Marketplace Management Portal
# Found in: AWS Marketplace Management Portal -> Products -> SaaS -> Product Details
AWS_MARKETPLACE_PRODUCT_CODE="dv2kw91hf8ev5532dkuf21f3x"

# Shared secret key used to authenticate Amazon EventBridge API Destination webhooks
# Configured in: EventBridge -> API Destinations -> Connection (Authorization Header)
AWS_EVENTBRIDGE_WEBHOOK_SECRET="your-secure-random-eventbridge-secret-key"

# (Optional) Amazon SQS Queue URL if buffering EventBridge notifications via SQS
AWS_MARKETPLACE_SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/906470608117/aws-marketplace-events-queue"

# (Optional) Secret token for invoking the SQS consumer endpoint /api/marketplace/aws/sqs/consume
AWS_SQS_CONSUMER_SECRET="your-secure-random-sqs-consumer-secret"

# ==============================================================================
# 7. SYSTEM SETTINGS & UPLOAD LIMITS
# ==============================================================================
# Maximum upload size for question bank files (.docx, .pdf, .xlsx) in MB (default: 20)
MAX_UPLOAD_SIZE_MB=20
