# ==============================================================================
# Microsoft Azure Marketplace SaaS Fulfillment Configuration
# ==============================================================================
# The Azure Active Directory (Entra ID) Tenant ID where your App Registration was created
MARKETPLACE_TENANT_ID=your-azure-tenant-id-guid

# The Application (Client) ID of your registered app in Azure Portal
MARKETPLACE_CLIENT_ID=your-azure-app-client-id-guid

# The Application Client Secret generated under Certificates & secrets in Azure Portal
MARKETPLACE_CLIENT_SECRET=your-azure-app-client-secret

# Standard Azure Marketplace SaaS Resource ID (Keep this default)
# Default: 20e940b3-4c77-4b0b-9a53-9e16a1b010a7
MARKETPLACE_RESOURCE_ID=20e940b3-4c77-4b0b-9a53-9e16a1b010a7

# Partner Center Publisher ID
MARKETPLACE_PUBLISHER_ID=your-partner-center-publisher-id

# Partner Center Offer ID configured under Commercial Marketplace
MARKETPLACE_OFFER_ID=your-saas-offer-id

# Base URL of your deployed application (used for redirects and webhook references)
APP_BASE_URL=https://examination-system-saa-s-opew.vercel.app

# ==============================================================================
# Application & Authentication Secrets
# ==============================================================================
# Secret used for signing session JWT tokens (minimum 32 characters)
AUTH_SECRET=your_minimum_32_character_auth_secret_key_here

# Maximum upload size for questions file in MB (optional, default: 20)
MAX_UPLOAD_SIZE_MB=20

# ==============================================================================
# Database Configuration (Prisma)
# ==============================================================================
# Pooled database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database?pgbouncer=true

# Direct database connection string (used for schema migrations and Prisma CLI)
DIRECT_URL=postgresql://user:password@host:5432/database

# ==============================================================================
# SMTP / Email Configuration (Nodemailer)
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_SECURE=false
SMTP_FROM="Examination Portal" <noreply@examportal.com>
